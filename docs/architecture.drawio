                    <mxGeometry height="50" width="290" x="65" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="p2_split" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;1 · SplitData&lt;/b&gt; (ProcessingStep)&lt;br&gt;image: sklearn 1.4-2 (py3)&lt;br&gt;script: code/preprocess.py&lt;br&gt;input: $InputData (raw.csv)&lt;br&gt;output: train / validation / test (60/20/20)&lt;br&gt;+ baseline.json (LogisticRegression)&lt;br&gt;CacheConfig: expire_after = PT2H" vertex="1">
                    <mxGeometry height="150" width="230" x="450" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="p2_train" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;2 · TrainFraudXGB&lt;/b&gt; (TrainingStep)&lt;br&gt;ModelTrainer · XGBoost 1.7-1&lt;br&gt;Compute: $TrainingInstanceType (ml.m5.large)&lt;br&gt;File channels (text/csv):&lt;br&gt;train ← SplitData.Outputs[train]&lt;br&gt;validation ← SplitData.Outputs[validation]&lt;br&gt;binary:logistic · 100 rounds · max_depth 6" vertex="1">
                    <mxGeometry height="150" width="230" x="730" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="p2_evaluate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;3 · EvaluateFraud&lt;/b&gt; (ProcessingStep)&lt;br&gt;image: XGBoost 1.7-1&lt;br&gt;script: code/evaluate.py --metric $MetricName&lt;br&gt;input: model.tar.gz + test.csv&lt;br&gt;output: evaluation.json&lt;br&gt;fixed key: binary_classification_metrics.metric.value&lt;br&gt;CacheConfig: PT2H" vertex="1">
                    <mxGeometry height="150" width="230" x="1010" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="p2_cond" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" value="&lt;b&gt;4 · CheckFraudMetric&lt;/b&gt;&lt;br&gt;JsonGet ≥ $MetricThreshold?&lt;br&gt;if: [RegisterFraudModel]&lt;br&gt;else: [FraudThresholdNotMet]" vertex="1">
                    <mxGeometry height="140" width="280" x="1320" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="p2_register" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;5 · RegisterFraudModel&lt;/b&gt; (ModelStep)&lt;br&gt;ModelBuilder + ModelMetrics (evaluation.json)&lt;br&gt;CreateModelPackage&lt;br&gt;$ModelApprovalStatus = PendingManualApproval&lt;br&gt;inference: ml.m5.large" vertex="1">
                    <mxGeometry height="130" width="280" x="1330" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="p2_fail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;FraudThresholdNotMet&lt;/b&gt; (FailStep)&lt;br&gt;error_message → Failed run&lt;br&gt;→ EventBridge → SNS" vertex="1">
                    <mxGeometry height="110" width="260" x="1010" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="p2_notes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fontColor=#333333;" value="&lt;b&gt;Design decisions&lt;/b&gt;&lt;br&gt;• evaluate.py ALWAYS writes the chosen metric under the fixed key binary_classification_metrics.metric.value (JsonGet takes no parameters).&lt;br&gt;• PT2H cache: same input + same code → SplitData is reused; EvaluateFraud recomputes when the trained model changes.&lt;br&gt;• Deploy is NOT a pipeline step: the pipeline only registers (ModelStep); the approval triggers the deployment (section 12 of the notebook).&lt;br&gt;• SDK V3 (sagemaker.mlops): ModelTrainer, ModelBuilder, ModelStep, FailStep, CacheConfig." vertex="1">
                    <mxGeometry height="180" width="1170" x="430" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e_s2t" edge="1" parent="1" source="p2_split" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" target="p2_train">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
