                <mxCell id="p3_s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="6. EvaluateFraud — configurable metric (--metric: roc_auc / f1 / recall / …)" vertex="1">
