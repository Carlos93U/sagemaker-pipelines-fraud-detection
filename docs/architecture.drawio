                    <mxGeometry height="60" width="490" x="65" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="p3_s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="4. SplitData — holdout 60/20/20 + baseline LogisticRegression (baseline.json)" vertex="1">
