                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e_e2c" edge="1" parent="1" source="p2_evaluate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" target="p2_cond">
